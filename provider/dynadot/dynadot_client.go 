package dynadot

import (
    "encoding/json"
    "fmt"
    "net/http"
    "net/url"
    "strings"
)

// DynadotClient is a simple client for Dynadot API.
type DynadotClient struct {
    httpClient *http.Client
    apiKey     string
}

// NewDynadotClient creates a new Dynadot API client.
func NewDynadotClient(httpClient *http.Client, apiKey string) *DynadotClient {
    return &DynadotClient{
        httpClient: httpClient,
        apiKey:     apiKey,
    }
}

// DynadotDomain represents a domain in Dynadot.
type DynadotDomain struct {
    Name string `json:"name"`
}

// DynadotRecord represents a DNS record in Dynadot.
type DynadotRecord struct {
    ID      string `json:"id"`
    Name    string `json:"name"`
    Type    string `json:"type"`
    Content string `json:"content"`
    TTL     int    `json:"ttl"`
}

// ListDomains lists all domains in the Dynadot account.
func (c *DynadotClient) ListDomains() ([]DynadotDomain, error) {
    apiURL := fmt.Sprintf("https://api.dynadot.com/api3.json?key=%s&command=list_domains", c.apiKey)
    resp, err := c.httpClient.Get(apiURL)
    if err != nil {
        return nil, err
    }
    defer resp.Body.Close()

    if resp.StatusCode != http.StatusOK {
        return nil, fmt.Errorf("failed to list domains: %s", resp.Status)
    }

    var domains []DynadotDomain
    err = json.NewDecoder(resp.Body).Decode(&domains)
    if err != nil {
        return nil, err
    }

    return domains, nil
}

// ListRecords lists all records for a specific domain.
func (c *DynadotClient) ListRecords(domainName string) ([]DynadotRecord, error) {
    apiURL := fmt.Sprintf("https://api.dynadot.com/api3.json?key=%s&command=list_dns", c.apiKey)
    data := url.Values{}
    data.Set("domain", domainName)

    resp, err := c.httpClient.Post(apiURL, "application/x-www-form-urlencoded", strings.NewReader(data.Encode()))
    if err != nil {
        return nil, err
    }
    defer resp.Body.Close()

    if resp.StatusCode != http.StatusOK {
        return nil, fmt.Errorf("failed to list records for domain %s: %s", domainName, resp.Status)
    }

    var records []DynadotRecord
    err = json.NewDecoder(resp.Body).Decode(&records)
    if err != nil {
        return nil, err
    }

    return records, nil
}

// CreateRecord creates a new DNS record.
func (c *DynadotClient) CreateRecord(domainName string, record DynadotRecord) (DynadotRecord, error) {
    apiURL := fmt.Sprintf("https://api.dynadot.com/api3.json?key=%s&command=set_dns", c.apiKey)
    data := url.Values{}
    data.Set("domain", domainName)
    data.Set("hostname", record.Name)
    data.Set("record_type", record.Type)
    data.Set("address", record.Content)
    data.Set("ttl", fmt.Sprint(record.TTL))

    resp, err := c.httpClient.Post(apiURL, "application/x-www-form-urlencoded", strings.NewReader(data.Encode()))
    if err != nil {
        return DynadotRecord{}, err
    }
    defer resp.Body.Close()

    if resp.StatusCode != http.StatusOK {
        return DynadotRecord{}, fmt.Errorf("failed to create record: %s", resp.Status)
    }

    return record, nil
}

// DeleteRecord deletes a DNS record.
func (c *DynadotClient) DeleteRecord(domainName, recordID string) error {
    apiURL := fmt.Sprintf("https://api.dynadot.com/api3.json?key=%s&command=delete_dns", c.apiKey)
    data := url.Values{}
    data.Set("domain", domainName)
    data.Set("record_id", recordID)

    resp, err := c.httpClient.Post(apiURL, "application/x-www-form-urlencoded", strings.NewReader(data.Encode()))
    if err != nil {
        return err
    }
    defer resp.Body.Close()

    if resp.StatusCode != http.StatusOK {
        return fmt.Errorf("failed to delete record: %s", resp.Status)
    }

    return nil
}
